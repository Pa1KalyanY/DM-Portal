# Environment Variables for LinkedIn Applicant Screening & Filtering System (Phase 1)
PORT=3001
NODE_ENV=development

# Database Configuration (Optional Supabase setup if connecting cloud Supabase instance)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# NOTE: Never expose service-role key to frontend!

# Application Settings
MAX_FILES_UPLOAD=50
MAX_FILE_SIZE_MB=50
